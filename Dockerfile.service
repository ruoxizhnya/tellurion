# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git

# Copy go mod files
COPY go.mod go.sum* ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build all services
#
# ODR-021 (P1-15) 删了 cmd/risk 与 cmd/execution；REV-16 又删了 cmd/strategy
# （策略资产/编译已拆到 tellurion-strategy）。SVC-CORE-DATA-RETIRE（2026-11-08）
# 删了 cmd/data —— 数据面整体迁到本仓之外（data-service 由数据仓发布镜像）。
# 这里构建本仓仍存在的三个进程：analysis-service / worker / dualrun（QT-79：
# 后两个此前只能裸跑）。
# 历史教训：删目录时必须同步删 Dockerfile 的 build/COPY 行——编译期不检查，
# 只有真 build 才炸，而 CI 不构建镜像就会一直静默。
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/analysis-service ./cmd/analysis && \
    CGO_ENABLED=0 GOOS=linux go build -o /app/worker ./cmd/worker && \
    CGO_ENABLED=0 GOOS=linux go build -o /app/dualrun ./cmd/dualrun

# Final stage
FROM alpine:3.19

WORKDIR /app

# Install CA certs for HTTPS calls and curl for health checks
RUN apk add --no-cache ca-certificates curl

# Copy binaries from builder
COPY --from=builder /app/analysis-service /app/analysis-service
COPY --from=builder /app/worker /app/worker
COPY --from=builder /app/dualrun /app/dualrun

# Copy config files
COPY config /app/config

# 依赖等待脚本。
#
# 「数据库跑宿主机、服务跑容器」形态下，postgres / redis 不再是 compose 成员，
# `depends_on: {condition: service_healthy}` 那层启动顺序保证随之消失 ——
# 而应用连不上 PG/Redis 是 logger.Fatal() 直接退出、**没有重试**
# （cmd/data/setup.go:137 / :146）。这个脚本把那层保证移到容器内部补回来。
# 由 docker-compose.yml 的 entrypoint + command 组合调用。
COPY deploy/wait-for-deps.sh /app/wait-for-deps.sh
RUN chmod +x /app/wait-for-deps.sh
#
# ⚠️ 此处曾有一行 `COPY cmd/analysis/static /app/cmd/analysis/static`。
# AUD-33（2026-09-22）退役 legacy HTML 时把那个目录整删了，这行没跟着删 →
# docker build 在最后一步炸：`failed to calculate checksum:
# "/cmd/analysis/static": not found`，于是 analysis-service 与 strategy-service
# 两个镜像从那天起就构建不出来（CI 不构建镜像、本地一直 go run，所以没人撞到；
# 症状是「compose 里定义了 6 个服务，实际只起得来 3 个」）。
# 与上面 ODR-021 那条**完全同型**：删目录时要连引用它的 Dockerfile COPY 一起删 ——
# 编译期不检查 COPY 的源路径，只有真 build 才炸，而没人 build 就永远静默。
# analysis-service 现在只提供 API，`:8085/` 返回 404 是预期行为，不需要静态目录。

# 8083 (risk) / 8084 (execution) 已随 ODR-021 合并进 analysis 的 8085。
EXPOSE 8081 8082 8085

# No ENTRYPOINT - docker-compose CMD specifies which service to run
